{
  "jobDefinitionName": "carddemo-cbtrn02c",
  "type": "container",
  "platformCapabilities": ["FARGATE"],
  "containerProperties": {
    "image": "${account}.dkr.ecr.${region}.amazonaws.com/carddemo-batch-cbtrn02c:${git_sha}",
    "command": [
      "--input", "Ref::dalytran",
      "--input", "Ref::xreffile",
      "--input", "Ref::acctfile",
      "--input", "Ref::tcatbalf",
      "--output-root", "Ref::output_root",
      "--run-date", "Ref::run_date",
      "--run-id", "Ref::run_id"
    ],
    "jobRoleArn": "arn:aws:iam::${account}:role/carddemo-cbtrn02c-job",
    "executionRoleArn": "arn:aws:iam::${account}:role/carddemo-batch-execution",
    "resourceRequirements": [
      {"type": "VCPU", "value": "1"},
      {"type": "MEMORY", "value": "2048"}
    ],
    "fargatePlatformConfiguration": {"platformVersion": "LATEST"},
    "networkConfiguration": {"assignPublicIp": "DISABLED"},
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/carddemo/batch",
        "awslogs-stream-prefix": "cbtrn02c"
      }
    }
  },
  "parameters": {
    "dalytran": "DALYTRAN=s3://${bucket}/carddemo/raw/dailytran.txt",
    "xreffile": "XREFFILE=s3://${bucket}/carddemo/raw/cardxref.txt",
    "acctfile": "ACCTFILE=s3://${bucket}/carddemo/raw/acctdata.txt",
    "tcatbalf": "TCATBALF=s3://${bucket}/carddemo/raw/tcatbal.txt",
    "output_root": "s3://${bucket}/carddemo/curated",
    "run_date": "2022-07-06",
    "run_id": "manual"
  },
  "retryStrategy": {"attempts": 1},
  "timeout": {"attemptDurationSeconds": 3600},
  "propagateTags": true
}
