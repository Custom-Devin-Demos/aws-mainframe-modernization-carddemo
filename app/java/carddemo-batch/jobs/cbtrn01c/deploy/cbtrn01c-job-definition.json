{
  "jobDefinitionName": "carddemo-cbtrn01c",
  "type": "container",
  "platformCapabilities": ["FARGATE"],
  "containerProperties": {
    "image": "${account}.dkr.ecr.${region}.amazonaws.com/carddemo-batch-cbtrn01c:${git_sha}",
    "command": [
      "--input", "Ref::dalytran",
      "--input", "Ref::custfile",
      "--input", "Ref::xreffile",
      "--input", "Ref::cardfile",
      "--input", "Ref::acctfile",
      "--input", "Ref::tranfile",
      "--output-root", "Ref::output_root",
      "--run-date", "Ref::run_date",
      "--run-id", "Ref::run_id"
    ],
    "jobRoleArn": "arn:aws:iam::${account}:role/carddemo-cbtrn01c-job",
    "executionRoleArn": "arn:aws:iam::${account}:role/carddemo-batch-execution",
    "resourceRequirements": [
      {"type": "VCPU", "value": "1"},
      {"type": "MEMORY", "value": "2048"}
    ],
    "fargatePlatformConfiguration": {"platformVersion": "LATEST"},
    "networkConfiguration": {"assignPublicIp": "DISABLED"},
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/carddemo/batch",
        "awslogs-stream-prefix": "cbtrn01c"
      }
    }
  },
  "parameters": {
    "dalytran": "DALYTRAN=s3://${bucket}/raw/dalytran/run_date=${run_date}/dailytran.txt",
    "custfile": "CUSTFILE=s3://${bucket}/raw/custfile/run_date=${run_date}/custdata.txt",
    "xreffile": "XREFFILE=s3://${bucket}/raw/xreffile/run_date=${run_date}/cardxref.txt",
    "cardfile": "CARDFILE=s3://${bucket}/raw/cardfile/run_date=${run_date}/carddata.txt",
    "acctfile": "ACCTFILE=s3://${bucket}/raw/acctfile/run_date=${run_date}/acctdata.txt",
    "tranfile": "TRANFILE=s3://${bucket}/raw/tranfile/run_date=${run_date}/transact.txt"
  },
  "retryStrategy": {"attempts": 1},
  "timeout": {"attemptDurationSeconds": 3600},
  "propagateTags": true
}
