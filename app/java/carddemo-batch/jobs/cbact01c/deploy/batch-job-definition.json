{
  "jobDefinitionName": "carddemo-cbact01c",
  "type": "container",
  "platformCapabilities": ["FARGATE"],
  "containerProperties": {
    "image": "${account}.dkr.ecr.${region}.amazonaws.com/carddemo-batch-cbact01c:${git_sha}",
    "command": [
      "--input", "Ref::acctfile",
      "--output-root", "Ref::output_root",
      "--run-date", "Ref::run_date",
      "--run-id", "Ref::run_id"
    ],
    "jobRoleArn": "arn:aws:iam::${account}:role/carddemo-cbact01c-job",
    "executionRoleArn": "arn:aws:iam::${account}:role/carddemo-batch-execution",
    "resourceRequirements": [
      {"type": "VCPU", "value": "1"},
      {"type": "MEMORY", "value": "2048"}
    ],
    "fargatePlatformConfiguration": {"platformVersion": "LATEST"},
    "networkConfiguration": {"assignPublicIp": "DISABLED"},
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/carddemo/batch",
        "awslogs-stream-prefix": "cbact01c"
      }
    }
  },
  "parameters": {
    "acctfile": "ACCTFILE=s3://${bucket}/carddemo/raw/ACCTFILE/run_date=1970-01-01/acctdata.txt",
    "output_root": "s3://${bucket}/carddemo",
    "run_date": "1970-01-01",
    "run_id": "manual"
  },
  "retryStrategy": {"attempts": 1},
  "timeout": {"attemptDurationSeconds": 3600},
  "propagateTags": true
}
